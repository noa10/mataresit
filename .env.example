# Public application URL (used for links and production auth redirects)
# Leave unset for local development so the current browser origin is used.
# VITE_SITE_URL=https://mataresit.vercel.app

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Real-time Notifications Configuration
# Set to 'true' to completely disable real-time notifications (forces fallback mode)
# VITE_DISABLE_REALTIME=false

# Set to 'false' to disable real-time in production (default: enabled)
# VITE_ENABLE_REALTIME=true

# Real-time Connection Settings (optional)
# Heartbeat interval in milliseconds (default: 30000)
# VITE_REALTIME_HEARTBEAT_INTERVAL=30000

# Maximum reconnection attempts (default: 5)
# VITE_REALTIME_MAX_RETRIES=5

# Stripe Configuration (Frontend)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# Stripe Price IDs
VITE_STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly_id
VITE_STRIPE_PRO_ANNUAL_PRICE_ID=price_pro_annual_id
VITE_STRIPE_MAX_MONTHLY_PRICE_ID=price_max_monthly_id
VITE_STRIPE_MAX_ANNUAL_PRICE_ID=price_max_annual_id

# Stripe Configuration (Backend - for Supabase Edge Functions)
# These should be set in your Supabase project settings as secrets.
# Live mode requires all four price IDs; a missing price ID fails closed
# instead of routing a live subscription to the free tier.
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# STRIPE_PRO_MONTHLY_PRICE_ID=price_...
# STRIPE_PRO_ANNUAL_PRICE_ID=price_...
# STRIPE_MAX_MONTHLY_PRICE_ID=price_...
# STRIPE_MAX_ANNUAL_PRICE_ID=price_...

# The handle_new_batch_item() database trigger reads the service-role key from
# Supabase Vault, not from this file. Create a Vault secret named
# `service_role_key` in Dashboard -> Database -> Vault. Never commit it.
#
# Edge Functions use the injected SUPABASE_SERVICE_ROLE_KEY (legacy JWT).
# New-format sb_secret_... keys are not a drop-in replacement for these
# functions: supabase-js 2.7.1 sends them as a Bearer token, which the platform
# rejects. SERVICE_ROLE_KEY is only a fallback when the built-in is absent.

# Public URLs used by Supabase Edge Functions
# Set these as Supabase function secrets for hosted deployments.
# SITE_URL=https://mataresit.vercel.app
# FRONTEND_URL=https://mataresit.vercel.app
# FROM_EMAIL=Mataresit <noreply@your-verified-domain>
# VAPID_EMAIL=mailto:admin@your-verified-domain
# BILLING_ALERT_EMAILS=finance@your-verified-domain

# AI Provider Configuration (Backend - Supabase Edge Function secrets)
# GEMINI_API_KEY=your_gemini_api_key
# GROQ_API_KEY=your_groq_api_key
# OPENROUTER_API_KEY=your_openrouter_api_key
