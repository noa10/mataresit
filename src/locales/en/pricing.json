        "question": "How does billing work?",
        "answer": "You're billed monthly or annually based on your chosen plan. You can upgrade, downgrade, or cancel anytime."
      },
      "limits": {
        "question": "What happens if I exceed my limits?",
        "answer": "You'll be notified when approaching limits. You can upgrade your plan or wait for the next billing cycle."
      },
      "trial": {
        "question": "Do you offer free trials?",
        "answer": "Yes! Pro and Max plans include a 14-day free trial. No credit card required."
      },
      "refund": {
        "question": "What's your refund policy?",
        "answer": "We offer a 30-day money-back guarantee for all paid plans."
      },
      "support": {
        "question": "What support do you provide?",
        "answer": "Free users get community support. Pro users get email support. Max users get priority support."
      }
